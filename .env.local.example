# ─── staysmart_fixed/.env.local — DROP-IN TEMPLATE ────────────────
# Copy this file to `.env.local` and fill in real values. `.env.local` is in
# `.gitignore`; never commit secrets.

# ─── Supabase (frontend reads VITE_*) ─────────────────────────────
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...                       # local Supabase anon key

# ─── Supabase (server-only — used inside Edge Functions) ─────────
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ─── Evolution API ────────────────────────────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=local-evolution-secret

# ─── ngrok public URL (must reach wa-webhook) ─────────────────────
# Run: ngrok start --all   → copy the https URL of the supabase-local tunnel
NGROK_URL=https://staysmart-supabase.ngrok-free.app

# ─── Google Gemini (replaces Anthropic Claude in wa-webhook) ────
GOOGLE_API_KEY=AIzaSy...                                    # https://aistudio.google.com/app/apikey
# Optional: pin a different Gemini model (defaults to gemini-2.5-flash-latest)
GEMINI_MODEL=gemini-2.5-flash-latest

# ─── Local-only development hints ─────────────────────────────────
NODE_ENV=development
VITE_APP_URL=http://localhost:5173
